<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.Debugger.ViewModels"
	xmlns:c="using:Mesen.Controls"
	mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="vm:PlaybackControlViewModel"
	x:Class="Mesen.Debugger.Views.PlaybackControlView"
>
	<Design.DataContext>
		<vm:PlaybackControlViewModel />
	</Design.DataContext>

	<Border BorderThickness="1" BorderBrush="#80808080" Padding="5">
		<Grid RowDefinitions="Auto,Auto,Auto">
			<TextBlock 
				Grid.Row="0"
				Text="{Binding CurrentFrame, StringFormat='Frame: {0}'}"
				FontSize="12"
				FontWeight="Bold"
				HorizontalAlignment="Center"
				Margin="0,0,0,5"
			/>
			
			<UniformGrid 
				Grid.Row="1"
				Rows="1" 
				Columns="6"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				ColumnSpacing="8"
			>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Play TAS"
						Click="OnPlayTAS"
						Icon="Assets/MediaPlay.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="▶" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Send playback to previous marker"
						Click="OnPreviousMarker"
						Icon="Assets/PreviousArrow.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&lt;&lt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Rewind 1 frame"
						Click="OnRewindFrame"
						Icon="Assets/StepBack.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&lt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Pause/Unpause Core"
						Click="OnTogglePause"
						Icon="Assets/MediaPause.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="||" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Advance 1 frame"
						Click="OnAdvanceFrame"
						Icon="Assets/StepInto.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&gt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Send playback to next marker"
						Click="OnNextMarker"
						Icon="Assets/NextArrow.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&gt;&gt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>
			</UniformGrid>

			<Border 
				Grid.Row="2" 
				Margin="0,10,0,0"
				Background="{DynamicResource TASPlaybackControlBackground}"
				BorderBrush="{DynamicResource TASPlaybackControlBorder}"
				BorderThickness="1"
				CornerRadius="4"
				Padding="12,8"
				HorizontalAlignment="Center"
				MaxWidth="320"
			>
				<Grid ColumnDefinitions="*,Auto,*">
					<CheckBox 
						Grid.Column="0"
						Content="Follow Cursor" 
						IsChecked="{Binding FollowCursor}"
						HorizontalAlignment="Center"
						FontSize="12"
						FontWeight="Medium"
					/>
					
					<Border 
						Grid.Column="1"
						Width="1"
						Background="{DynamicResource TASPlaybackControlSeparator}"
						Margin="15,0"
					/>
					
					<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
						<Slider 
							Minimum="0.25" 
							Maximum="1.5" 
							Value="{Binding SeekSpeed}"
							Width="80"
							IsSnapToTickEnabled="True"
							TickFrequency="0.25"
							VerticalAlignment="Center"
						>
							<Slider.Styles>
								<Style Selector="Slider /template/ Border#PART_TrackBackground">
									<Setter Property="Height" Value="4"/>
									<Setter Property="Background" Value="{DynamicResource TASSliderTrackBackground}"/>
									<Setter Property="CornerRadius" Value="2"/>
								</Style>
								<Style Selector="Slider /template/ Thumb#PART_Thumb">
									<Setter Property="Width" Value="8"/>
									<Setter Property="Height" Value="18"/>
									<Setter Property="CornerRadius" Value="2"/>
									<Setter Property="Background" Value="{DynamicResource TASSliderThumbBackground}"/>
									<Setter Property="BorderBrush" Value="{DynamicResource TASSliderThumbBorder}"/>
									<Setter Property="BorderThickness" Value="1"/>
								</Style>
								<Style Selector="Slider /template/ Thumb#PART_Thumb:pointerover">
									<Setter Property="Background" Value="{DynamicResource TASSliderThumbPointerOver}"/>
								</Style>
								<Style Selector="Slider /template/ Thumb#PART_Thumb:pressed">
									<Setter Property="Background" Value="{DynamicResource TASSliderThumbPressed}"/>
								</Style>
							</Slider.Styles>
						</Slider>
						<TextBlock 
							Text="{Binding SeekSpeed, StringFormat={}{0:F2}x}" 
							VerticalAlignment="Center" 
							FontSize="12"
							FontWeight="Medium"
							Width="45"
						/>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Border>
</UserControl>
