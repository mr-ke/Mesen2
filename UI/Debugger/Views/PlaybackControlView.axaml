<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Mesen.Debugger.ViewModels"
	xmlns:c="using:Mesen.Controls"
	mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	x:DataType="vm:PlaybackControlViewModel"
	x:Class="Mesen.Debugger.Views.PlaybackControlView"
>
	<Design.DataContext>
		<vm:PlaybackControlViewModel />
	</Design.DataContext>

	<Border BorderThickness="1" BorderBrush="#80808080" Padding="5">
		<Grid RowDefinitions="Auto,*">
			<TextBlock 
				Grid.Row="0"
				Text="{Binding CurrentFrame, StringFormat='Frame: {0}'}"
				FontSize="12"
				FontWeight="Bold"
				HorizontalAlignment="Center"
				Margin="0,0,0,5"
			/>
			
			<UniformGrid 
				Grid.Row="1"
				Rows="1" 
				Columns="6"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				ColumnSpacing="8"
			>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Play TAS"
						Click="OnPlayTAS"
						Icon="Assets/MediaPlay.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="▶" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Send playback to previous marker"
						Click="OnPreviousMarker"
						Icon="Assets/PreviousArrow.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&lt;&lt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Rewind 1 frame"
						Click="OnRewindFrame"
						Icon="Assets/StepBack.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&lt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Pause/Unpause Core"
						Click="OnTogglePause"
						Icon="Assets/MediaPause.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="||" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Advance 1 frame"
						Click="OnAdvanceFrame"
						Icon="Assets/StepInto.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&gt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<c:IconButton
						Grid.Row="1"
						Grid.Column="1"
						ToolTip.Tip="Send playback to next marker"
						Click="OnNextMarker"
						Icon="Assets/NextArrow.png"
						Width="40"
						Height="40"
						Margin="0"
					>
						<Viewbox Stretch="Uniform">
							<TextBlock Text="&gt;&gt;" />
						</Viewbox>
					</c:IconButton>
				</Grid>
			</UniformGrid>
		</Grid>
	</Border>
</UserControl>
